# UniAssist AI Configuration Example

# Server Environment
PORT=5000
NODE_ENV=development
JWT_SECRET=uniassist_super_secret_jwt_key_2026_change_in_production
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL="file:./dev.db"
# For PostgreSQL Production:
# DATABASE_URL="postgresql://user:password@localhost:5432/uniassist_db?schema=public"

# AI Integration (OpenAI / Gemini / Groq / Custom LLM API)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
AI_CONFIDENCE_THRESHOLD=0.65

# WhatsApp Business Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
WHATSAPP_VERIFY_TOKEN=uniassist_whatsapp_verify_token_2026

# Email / Notification SMTP Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@university.edu
SMTP_PASS=your_email_app_password
